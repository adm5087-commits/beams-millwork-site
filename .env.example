# Resend API key (resend.com > API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Sender. Must be on a domain verified in Resend.
MAIL_FROM=Beam's Millwork Website <website@beamsmillwork.com>

# Default recipient(s), comma separated
MAIL_TO=you@beamsmillwork.com

# Optional: route each form somewhere else (falls back to MAIL_TO)
CAREERS_TO=
CONTACT_TO=

# Send an automatic "we received it" email to the person who submitted (true/false)
SEND_CONFIRMATION=true
